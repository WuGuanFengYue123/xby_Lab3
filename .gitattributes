# 统一行尾符策略（优先于 core.autocrlf）
* text=auto

# 源码/脚本保持 LF
*.java          text eol=lf
*.xml           text eol=lf
*.properties    text eol=lf
*.md            text eol=lf
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf

# Windows 批处理保持 CRLF（确保 mvnw.cmd 在 Windows 可运行）
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Maven Wrapper 建议固定行尾
mvnw            text eol=lf
mvnw.cmd        text eol=crlf

# 二进制文件
*.jar           binary
*.class         binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
